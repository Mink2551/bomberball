rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rooms collection - for game lobbies
    match /rooms/{roomCode} {
      // Anyone can read rooms (to check if room exists, see players)
      allow read: if true;
      
      // Anyone can create a room
      allow create: if true;
      
      // Anyone can update rooms (join, leave, toggle ready, start game)
      // In production, you'd want to validate the specific fields being updated
      allow update: if true;
      
      // Anyone can delete rooms (when last player leaves)
      allow delete: if true;
    }
    
    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
